<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /eisen/
    
    # If the request is not for a real file or directory, 
    # and not for the root index.html itself, redirect to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /eisen/index.html [L]
</IfModule>

# Handle 404s by serving the fallback file generated by SvelteKit
ErrorDocument 404 /eisen/404.html
